# Kei Inference API Configuration
KEI_BASE_URL=https://api.kei-inference.web.id/v1
KEI_API_KEY=sk-your-key-here
KEI_DEFAULT_MODEL=glm-5.3-flash
KEI_FAST_MODEL=glm-5.3-flash
KEI_REASONING_MODEL=deepseek-v4.1-flash

# Agent Workspace Root
WORKSPACE_DIR=./.workspace

# Security & Limits
MAX_AGENT_TURNS=15
CHILD_PROCESS_TIMEOUT_MS=30000
MAX_BUFFER_SIZE_MB=10
AUTO_REDACT_SECRETS=true
